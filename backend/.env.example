# Banco (Neon em produção; no docker-compose local sobrescreve para o serviço db)
DATABASE_URL=postgresql://iron:iron@localhost:5433/iron

# Clerk
CLERK_WEBHOOK_SECRET=whsec_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# origens permitidas (CORS), separadas por vírgula
CORS_ORIGINS=http://localhost:5173

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# webhook (produção) | polling (dev local, sem URL pública)
TELEGRAM_MODE=polling
PUBLIC_BASE_URL=https://api.exemplo.com
SITE_URL=http://localhost:5173

# LLM
OPENAI_API_KEY=
IRON_MODEL_LOW=gpt-4.1-mini
IRON_MODEL_MEDIUM=gpt-4.1-mini
IRON_MODEL_HIGH=gpt-4.1

# Processos em segundo plano (manter true em 1 réplica só)
RUN_WORKER=true
RUN_SCHEDULER=true
DAILY_MESSAGE_LIMIT=100

SENTRY_DSN=
