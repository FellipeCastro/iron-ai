{
  "name": "iron-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "npm test && npm run test:integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx db/seed/index.ts",
    "db:seed-demo": "tsx scripts/seed-demo-user.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "telegram:webhook": "tsx scripts/telegram-webhook.ts",
    "ai:export-golden": "tsx scripts/export-golden.ts",
    "ai:eval": "tsx scripts/eval-parser.ts",
    "trigger:dev": "cross-env NODE_OPTIONS=--no-experimental-webstorage npx trigger.dev@4.8.1 dev"
  },
  "dependencies": {
    "@clerk/localizations": "^4.24.1",
    "@clerk/nextjs": "^7.9.20",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@neondatabase/serverless": "^1.2.0",
    "@next/env": "^16.4.3",
    "@sentry/core": "^11.9.0",
    "@sentry/nextjs": "^11.9.0",
    "@sentry/node": "^11.9.0",
    "@trigger.dev/sdk": "4.8.1",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.3",
    "openai": "^7.43.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "stripe": "^23.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@trigger.dev/build": "4.8.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
